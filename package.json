    "react-dom": "18.2.0",
    "recharts": "^2.15.4",
    "swr": "^2.5.1"
  },
  "devDependencies": {
    "@commitlint/cli": "17.2.0",
    "@commitlint/config-conventional": "17.2.0",
    "@rocketseat/eslint-config": "1.1.3",
    "@testing-library/jest-dom": "5.16.5",
    "@testing-library/react": "13.4.0",
    "@types/node": "18.11.9",
    "@types/react": "18.0.25",
